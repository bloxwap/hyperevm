{
  "name": "@bloxwap/hyperevm-workspace",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "bun run check:format && bun run check:lint && bun run check:sdk",
    "check:format": "biome format .",
    "check:lint": "biome lint .",
    "check:sdk": "cd packages/hyperevm && bun run typecheck",
    "format": "biome format --write .",
    "lint": "biome lint --write .",
    "typecheck": "bun run check:sdk",
    "test": "cd packages/hyperevm && bun run test",
    "build": "cd packages/hyperevm && bun run build",
    "rank": "cd packages/hyperevm && bun run rank"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15"
  }
}
